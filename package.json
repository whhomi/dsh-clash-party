{
  "name": "dsh-proxy",
  "version": "0.2.0",
  "description": "Self-hosted mihomo core for the DSH host: subscription providers, single-node import (ss/trojan/vmess/vless/hysteria2/tuic), per-process egress routing, agent tools and a Proxy panel in the web client — without running any external proxy client.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whhomi/dsh-clash-party.git"
  },
  "homepage": "https://github.com/whhomi/dsh-clash-party#readme",
  "bugs": {
    "url": "https://github.com/whhomi/dsh-clash-party/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "proxy",
    "mihomo",
    "clash"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT"
}
